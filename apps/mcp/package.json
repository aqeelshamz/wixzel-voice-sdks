{
  "name": "wixzel-voice-mcp",
  "version": "0.4.0",
  "description": "MCP server for Wixzel Voice — lets Claude, ChatGPT, Cursor and any other MCP client create voice agents, place and answer real phone calls, manage leads and campaigns, and read usage over the Wixzel Voice API.",
  "mcpName": "com.wixzel/voice",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wixzel-voice-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wixzel",
    "voice-agents",
    "telephony",
    "claude-code",
    "ai-agents",
    "mcp-server",
    "phone-calls",
    "voice-ai",
    "ai-voice-agent",
    "sip-trunk",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqeelshamz/wixzel-voice-sdks.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://voice.wixzel.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
